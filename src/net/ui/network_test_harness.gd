	_main_container = VBoxContainer.new()
	_main_container.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_main_container.add_theme_constant_override("separation", 8)
	add_child(_main_container)
	
	# Adds the harness title at the top of the interface.
	var title : Label = Label.new()
	title.text = "Network Test Harness"
	_main_container.add_child(title)
	
	# Adds the label used to show the current role and connection status.
	_status_label = Label.new()
	_main_container.add_child(_status_label)
	
	# Adds the label used to show the local peer ID.
