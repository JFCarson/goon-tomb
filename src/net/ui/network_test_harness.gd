class_name NetworkTestHarness
extends Control

## Test harness for checking network/netcode functionality outside of the
## game.


# Config
## Packet type used by all test messages sent through this harness.
const test_packet_type : PacketEnums.Type = PacketEnums.Type.TEST_PACKET
## Highest permitted message ID before the counter wraps back to 1.
const max_message_id : int = 65535


# Runtime
## Root container holding all controls created by this harness.
var _main_container : VBoxContainer
## Displays the current network role and connection status.
var _status_label : Label
## Displays the local peer ID, or indicates that it is unassigned.
var _peer_id_label : Label
## Displays the connected client IDs or the server peer ID.
var _connected_peers_label : Label
## Displays timestamped events generated by the harness.
var _event_log_label : Label
## Displays the current packet statistics.
var _statistics_label : Label
## Input field used to select a peer for targeted server sends.
var _target_peer_input : LineEdit
## Input field containing the integer value carried by test packets.
var _test_value_input : LineEdit
## Container holding the shared test value input controls.
var _test_value_section : VBoxContainer
## Container holding controls for sending packets from a client to the server.
var _send_to_server_section : VBoxContainer
## Container holding server broadcast and targeted-send controls.
var _server_packet_section : VBoxContainer
## Container holding packet statistics and the reset button.
var _statistics_section : VBoxContainer
## Button that starts a server on this instance.
var _start_server_button : Button
## Button that attempts to connect this instance to a server.
var _connect_server_button : Button
## Button that stops the server hosted by this instance.
var _stop_server_button : Button
## Button that disconnects this instance from its current peer.
var _disconnect_button : Button
## Button that sends a test packet from a client to the server.
var _send_to_server_button : Button
## Button that broadcasts a test packet from the server to its clients.
var _broadcast_button : Button
## Button that sends a test packet from the server to one selected client.
var _send_to_peer_button : Button
## Button that resets all packet statistics to zero.
var _reset_statistics_button : Button

## ID assigned to the next test message; wraps to 1 after max_message_id.
var _next_message_id : int = 1

## Number of send requests recorded by this harness.
var _packets_sent : int = 0
## Number of test packets received by this harness.
var _packets_received : int = 0
## Number of test packets received in the client-to-server direction.
var _client_to_server_received : int = 0
## Number of test packets received in the server-to-client direction.
var _server_to_client_received : int = 0
## Number of targeted send operations reported as failures.
var _send_failures : int = 0


# Lifecycle
## Creates the harness UI, connects signals, and initializes its displays.
func _ready() -> void:
	_create_status_ui()
	_connect_multiplayer_signals()
	_connect_packet_signals()
	_refresh_status()
	_refresh_statistics()


## Refreshes the connection status display every frame.
func _process(_delta : float) -> void:
	_refresh_status()


## Disconnects packet signal handlers when this node leaves the scene tree.
func _exit_tree() -> void:
	_disconnect_packet_signals()


# UI
## Creates and arranges all labels, input fields, and buttons used by the harness.
