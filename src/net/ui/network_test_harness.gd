# Signals
## Connects multiplayer lifecycle signals, avoiding duplicate connections.
func _connect_multiplayer_signals() -> void:
	# Fires when this client successfully connects to the server.
	if not multiplayer.connected_to_server.is_connected(_on_connected_to_server):
		multiplayer.connected_to_server.connect(_on_connected_to_server)
		
	# Fires when a client connection attempt fails.
	if not multiplayer.connection_failed.is_connected(_on_connection_failed):
		multiplayer.connection_failed.connect(_on_connection_failed)
		
	# Fires when the connected client loses its server connection.
	if not multiplayer.server_disconnected.is_connected(_on_server_disconnected):
		multiplayer.server_disconnected.connect(_on_server_disconnected)
		
	# Fires when a peer joins the multiplayer session.
	if not multiplayer.peer_connected.is_connected(_on_peer_connected):
		multiplayer.peer_connected.connect(_on_peer_connected)
		
	# Fires when a peer leaves the multiplayer session.
	if not multiplayer.peer_disconnected.is_connected(_on_peer_disconnected):
		multiplayer.peer_disconnected.connect(_on_peer_disconnected)


## Connects the network packet signals used to receive decoded packets.
func _connect_packet_signals() -> void:
	# Receives packets routed to the server-side packet handler.
	if not NetworkGlobals.handle_server_packet.is_connected(_on_server_packet_received):
		NetworkGlobals.handle_server_packet.connect(_on_server_packet_received)
		
	# Receives packets routed to the client-side packet handler.
	if not NetworkGlobals.handle_client_packet.is_connected(_on_client_packet_received):
		NetworkGlobals.handle_client_packet.connect(_on_client_packet_received)


## Disconnects this harness's packet handlers to avoid lingering callbacks.
func _disconnect_packet_signals() -> void:
	# Disconnects the server packet handler if it is currently connected.
	if NetworkGlobals.handle_server_packet.is_connected(_on_server_packet_received):
		NetworkGlobals.handle_server_packet.disconnect(_on_server_packet_received)
		
	# Disconnects the client packet handler if it is currently connected.
	if NetworkGlobals.handle_client_packet.is_connected(_on_client_packet_received):
		NetworkGlobals.handle_client_packet.disconnect(_on_client_packet_received)


# Connection Actions
## Starts a server and logs whether the operation appears successful.
func _on_server_pressed() -> void:
	NetHandler.start_server()
	
	# Uses the reported network role to check whether the server started.
	if _get_network_role() == "Server":
		_log_event("Server started.")
	else:
		_log_event("Server failed to start.")
		
	_refresh_status()


## Requests a client connection.
func _on_client_pressed() -> void:
	NetHandler.start_client()
	_log_event("Client connection requested.")
	_refresh_status()


## Stops the server if this instance currently has the server role.
func _on_stop_server_pressed() -> void:
	# Prevents a client or disconnected instance from stopping the server.
	if _get_network_role() != "Server":
		_log_event("Cannot stop server: this instance is not the server.")
		return
		
	NetHandler.stop_server()
	_log_event("Server stopped.")
	_refresh_status()


## Disconnects this instance if a multiplayer peer has been configured.
func _on_disconnect_pressed() -> void:
	# Avoids attempting to disconnect when there is no peer to disconnect.
	if multiplayer.multiplayer_peer == null:
		return
		
	NetHandler.disconnect_client()
	_log_event("Disconnected.")
	_refresh_status()


# Packet Test Actions
## Sends a test packet from a connected client to the server.
func _on_send_to_server_pressed() -> void:
	# Only a connected client may send a packet through this action.
	if not _has_connected_client():
		_log_event("Cannot send: this instance is not a connected client.")
		return
		
	# Stops the send if the entered test value is invalid.
	if not _validate_test_value():
		return
		
	# Allocates a message ID and reads the validated integer value.
	var message_id : int = _get_next_message_id()
	var test_value : int = int(_test_value_input.text.strip_edges())
	
	# Builds the packet payload and passes it to the network layer.
	var values : Dictionary = _create_test_values(message_id, test_value)
	NetworkGlobals.send_packet_to_server(test_packet_type, values)
	
	# Counts the send request, not confirmed delivery.
	_packets_sent += 1
	_refresh_statistics()
	
	# Records the message ID and test value in the event log.
	_log_event("Test sent to server: ID=%s, value=%s" % [message_id, test_value])


## Broadcasts a test packet from the server to connected clients.
func _on_broadcast_pressed() -> void:
	# Prevents clients from invoking the server-only broadcast operation.
	if _get_network_role() != "Server":
		_log_event("Cannot broadcast: this instance is not the server.")
		return
		
	# Stops the broadcast if the entered test value is invalid.
	if not _validate_test_value():
		return
		
	# Allocates a message ID and reads the validated integer value.
	var message_id : int = _get_next_message_id()
	var test_value : int = int(_test_value_input.text.strip_edges())
	
	# Builds the packet payload and requests a broadcast through the network layer.
	var values : Dictionary = _create_test_values(message_id, test_value)
	NetworkGlobals.broadcast_packet(test_packet_type, values)
	
	# Counts one broadcast request, not one packet per recipient.
	_packets_sent += 1
	_refresh_statistics()
	
	# Records the broadcast request in the event log.
	_log_event("Broadcast requested: ID=%s, value=%s" % [message_id, test_value])


## Sends a test packet from the server to one specified connected client.
func _on_send_to_peer_pressed() -> void:
	# Prevents clients from using the server-only targeted-send operation.
	if _get_network_role() != "Server":
		_log_event("Cannot target a peer: this instance is not the server.")
		return
		
	# Stops the send if the entered test value is invalid.
	if not _validate_test_value():
		return
		
	# Ensures the target peer ID can be parsed as an integer.
	if not _target_peer_input.text.is_valid_int():
		_log_event("Invalid target peer ID.")
		return
		
	# Reads the target peer ID entered by the user.
	var target_peer_id : int = int(_target_peer_input.text)
	
	# Rejects the server's own ID and any lower or invalid peer IDs.
	if target_peer_id <= NetHandler.server_id:
		_log_event("Target peer ID must be greater than 1.")
		return
		
	# Ensures the target is currently listed as a connected peer.
	if not multiplayer.get_peers().has(target_peer_id):
		_log_event("Target peer is not connected: %s" % target_peer_id)
		return
		
	# Allocates a message ID and reads the validated integer value.
	var message_id : int = _get_next_message_id()
	var test_value : int = int(_test_value_input.text.strip_edges())
	
	# Builds the payload and attempts to send it to the selected peer.
	var values : Dictionary = _create_test_values(message_id, test_value)
	var sent : bool = NetworkGlobals.send_packet_to_peer(test_packet_type, values, target_peer_id)
	
	# Updates the counters and event log according to the send result.
	if sent:
		_packets_sent += 1
		_log_event("Test sent to peer %s: ID=%s, value=%s" % [target_peer_id, message_id, test_value])
	else:
		_send_failures += 1
		_log_event("Failed to send test packet to peer %s." % target_peer_id)
		
	_refresh_statistics()


# Packet Helpers
## Creates the dictionary payload expected by the test packet decoder.
func _create_test_values(message_id : int, test_value : int) -> Dictionary:
	return {
		PacketEnums.FieldName.MESSAGE_ID: message_id,
		PacketEnums.FieldName.TEST_VALUE: test_value
	}


## Returns the next message ID and advances the counter for future sends.
func _get_next_message_id() -> int:
	var message_id : int = _next_message_id
	
	_next_message_id += 1
	
	# Keeps message IDs within the configured range and reserves zero.
	if _next_message_id > max_message_id:
		_next_message_id = 1
		
	return message_id


## Validates that the test input is an integer within the signed 32-bit range.
func _validate_test_value() -> bool:
	# Removes leading and trailing whitespace before validation.
	var text_value : String = _test_value_input.text.strip_edges()
	
	# Rejects input that cannot be parsed as an integer.
	if not text_value.is_valid_int():
		_log_event("Test value must be a valid integer.")
		return false
		
	# Converts the validated text into an integer for range checking.
	var value : int = int(text_value)
	
	# Rejects values outside the signed 32-bit integer limits.
	if value < -2147483648 or value > 2147483647:
		_log_event("Test value is outside the INT32 range.")
		return false
		
	return true


# Packet Receive Handlers
## Handles decoded packets routed to the server packet signal.
func _on_server_packet_received(peer_id : int, packet : DecodedPacket) -> void:
	# Ignores packet types that are not part of this harness's test protocol.
	if packet.packet_type_id != test_packet_type:
		return
		
	# Counts the received packet and records its direction.
	_packets_received += 1
	_client_to_server_received += 1
	_refresh_statistics()
	
	# Logs the sender and payload fields of the received packet.
	_log_test_packet("Client -> Server", peer_id, packet)


## Handles decoded packets routed to the client packet signal.
func _on_client_packet_received(packet : DecodedPacket) -> void:
	# Ignores packet types that are not part of this harness's test protocol.
	if packet.packet_type_id != test_packet_type:
		return
		
	# Counts the received packet and records its direction.
	_packets_received += 1
	_server_to_client_received += 1
	_refresh_statistics()
	
	# Uses the sender ID included in the decoded packet for logging.
	_log_test_packet("Server -> Client", packet.sender_peer_id, packet)


## Extracts the test fields from a decoded packet and writes them to the event log.
func _log_test_packet(direction : String, sender_peer_id : int, packet : DecodedPacket) -> void:
	# Uses fallback values if either expected field is missing from the payload.
	var message_id : int = int(packet.values.get(PacketEnums.FieldName.MESSAGE_ID, -1))
	var test_value : int = int(packet.values.get(PacketEnums.FieldName.TEST_VALUE, 0))
	
	# Includes the direction, sender, message ID, and test value in the log.
	_log_event("%s | Sender=%s | ID=%s | Value=%s" % [direction, sender_peer_id, message_id, test_value])


# Packet Statistics
## Rebuilds the statistics label from the current counter values.
func _refresh_statistics() -> void:
	# The UI may not have been created yet when this function is called.
	if _statistics_label == null:
		return

	# Displays send requests, received packets by direction, and reported failures.
	_statistics_label.text = (
		"Send requests: %s\n"
		+ "Packets received: %s\n"
		+ "Client -> Server received: %s\n"
		+ "Server -> Client received: %s\n"
		+ "Reported send failures: %s"
	) % [
		_packets_sent,
		_packets_received,
		_client_to_server_received,
		_server_to_client_received,
		_send_failures
	]


## Resets all statistics counters without changing the current connection.
func _on_reset_statistics_pressed() -> void:
	_packets_sent = 0
	_packets_received = 0
	_client_to_server_received = 0
	_server_to_client_received = 0
	_send_failures = 0
	
	# Refreshes the display so the reset is visible immediately.
	_refresh_statistics()
	_log_event("Packet statistics reset.")


# Status
## Determines the local network role from the current peer and NetHandler state.
func _get_network_role() -> String:
	# Retrieves the peer configured on the SceneTree multiplayer API.
	var peer : MultiplayerPeer = multiplayer.multiplayer_peer
	
	# Treats missing or inactive peer state as disconnected.
	if peer == null or not NetHandler._has_active_peer():
		return "Not Connected"
		
	# Only the ENet peer implementation is classified by this harness.
	if peer is ENetMultiplayerPeer:
		# The NetHandler flag identifies this instance as the server.
		if NetHandler._is_server:
			return "Server"
			
		# Distinguishes a client that is still attempting to connect.
		if peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTING:
			return "Client (Connecting)"
			
		# Reports the client role once the connection is established.
		if peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTED:
			return "Client"
			
	return "Not Connected"


## Returns true only when this instance is an established client connection.
func _has_connected_client() -> bool:
	# No peer means there cannot be an established client connection.
	if multiplayer.multiplayer_peer == null:
		return false
		
	# Rejects server instances and any other non-client role.
	if _get_network_role() != "Client":
		return false
		
	# Confirms the underlying peer reports a connected state.
	var peer : MultiplayerPeer = multiplayer.multiplayer_peer
	
	return (peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTED)


## Updates connection labels and delegates visibility and button state changes.
func _refresh_status() -> void:
	# Avoids accessing labels before the UI has been created.
	if _status_label == null:
		return
		
	# Retrieves the configured multiplayer peer.
	var peer : MultiplayerPeer = multiplayer.multiplayer_peer
	
	# Shows the disconnected state and hides controls that require a connection.
	if peer == null or not NetHandler._has_active_peer():
		_status_label.text = "Role: Not Connected | Status: Disconnected"
		_peer_id_label.text = "Local peer ID: Unassigned"
		_connected_peers_label.text = "Connected peers: None"
		_update_buttons(false, false, false, false)
		return
		
	# Derives connection flags from the peer's current connection status.
	var connection_status : MultiplayerPeer.ConnectionStatus = (peer.get_connection_status())
	var connection_established : bool = (connection_status == MultiplayerPeer.CONNECTION_CONNECTED)
	var is_connecting : bool = (connection_status == MultiplayerPeer.CONNECTION_CONNECTING)
	var role_text : String = _get_network_role()
	var is_server : bool = role_text == "Server"
	
	# Converts the peer's connection status into text for the UI.
	var status_text : String = "Disconnected"
	
	match connection_status:
		MultiplayerPeer.CONNECTION_CONNECTING:
			status_text = "Connecting"
		MultiplayerPeer.CONNECTION_CONNECTED:
			status_text = "Connected"
			
	# Displays the current role, connection state, and local peer ID.
	_status_label.text = "Role: %s | Status: %s" % [role_text, status_text]
	_peer_id_label.text = "Local peer ID: %s" % multiplayer.get_unique_id()
	
	# Servers list connected client IDs; clients display the server's ID.
	if is_server:
		_connected_peers_label.text = "Connected client IDs: %s" % str(multiplayer.get_peers())
	else:
		_connected_peers_label.text = "Server peer ID: %s" % NetHandler.server_id
		
	# Applies UI visibility and enabled states for the current connection.
	_update_buttons(true, is_server, connection_established, is_connecting)


## Shows or hides controls and enables buttons according to the current role.
func _update_buttons(has_peer : bool, is_server : bool, connection_established : bool, is_connecting : bool) -> void:
	# Server startup and client connection are available only without a peer.
	_start_server_button.visible = not has_peer
	_connect_server_button.visible = not has_peer
	
	# Servers can stop their server; non-server peers can disconnect.
	_stop_server_button.visible = has_peer and is_server
	_disconnect_button.visible = has_peer and not is_server
	
	# The shared test value is only needed while a connection is established.
	_test_value_section.visible = connection_established
	
	# Shows packet controls appropriate to the connected role.
	_send_to_server_section.visible = (has_peer and not is_server and connection_established)
	_server_packet_section.visible = (has_peer and is_server and connection_established)
	
	# Disables packet operations unless the relevant role is connected.
	_send_to_server_button.disabled = not connection_established or is_server
	_broadcast_button.disabled = not connection_established or not is_server
	_send_to_peer_button.disabled = not connection_established or not is_server
	
	# Prevents additional startup/connection attempts while connecting.
	_start_server_button.disabled = is_connecting
	_connect_server_button.disabled = is_connecting


# Multiplayer Event Handlers
## Handles the successful connection of this client to its server.
func _on_connected_to_server() -> void:
	_log_event("Connected to server.")
	_refresh_status()


## Handles a failed attempt to connect to a server.
func _on_connection_failed() -> void:
	_log_event("Connection failed.")
	_refresh_status()


## Handles the server disconnecting from this client.
func _on_server_disconnected() -> void:
	_log_event("Server disconnected.")
	_refresh_status()


## Logs when another peer joins the multiplayer session.
func _on_peer_connected(peer_id : int) -> void:
	_log_event("Peer connected: %s" % peer_id)
	_refresh_status()


## Logs when another peer leaves the multiplayer session.
func _on_peer_disconnected(peer_id : int) -> void:
	_log_event("Peer disconnected: %s" % peer_id)
	_refresh_status()


# Event Log
## Adds a timestamped event to the top of the event log.
func _log_event(message : String) -> void:
	# Allows calls before the event log label has been created.
	if _event_log_label == null:
		return
		
	# Uses the system clock to timestamp the new event.
	var timestamp : String = Time.get_time_string_from_system()
	
	# Places the newest event first and retains the existing log below it.
	_event_log_label.text = "Events:\n%s\n%s" % [
		timestamp + " - " + message,
		_event_log_label.text.trim_prefix("Events:\n")
	]
